# Community Service Desk - Environment Configuration
# Copy this file to .env for local development

# Environment mode: development, testing, production
CSD_ENVIRONMENT=development
CSD_DEBUG=false

# Application Security
# Generate a secure key in production (e.g., `openssl rand -hex 32`)
CSD_SECRET_KEY=dev-insecure-secret-key-change-in-production-32charsmin!
CSD_ALGORITHM=HS256
CSD_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Docker Compose PostgreSQL 17 connection (port 5433 by default to prevent host port 5432 collisions):
CSD_DATABASE_URL=postgresql+psycopg://csd_user:csd_password@localhost:5433/csd_db
# Or native PostgreSQL: postgresql+psycopg://csd_user:csd_password@localhost:5432/csd_db
# For zero-dependency local testing or quick evaluation:
# CSD_DATABASE_URL=sqlite:///./csd_dev.db

# Attachment Storage Configuration
CSD_STORAGE_BACKEND=local
CSD_STORAGE_LOCAL_DIR=./uploads
CSD_MAX_UPLOAD_BYTES=10485760

# Server Binding
CSD_HOST=127.0.0.1
CSD_PORT=8000
